{
  "name": "sanjing-cli",
  "version": "1.1.0",
  "description": "前端简易脚手架工具",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "author": {
    "name": "sanjing",
    "email": "sanjings@qq.com"
  },
  "bin": {
    "s-cli": "./bin/cmd",
    "sanjing-cli": "./bin/cmd"
  },
  "files": [
    "dist",
    "bin"
  ],
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "tsc",
    "cli": "node dist/index.js",
    "dev": "tsc -w",
    "clean": "rimraf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "prepublishOnly": "pnpm run build && pnpm run test"
  },
  "keywords": [
    "cli",
    "scaffold",
    "脚手架",
    "vue",
    "template"
  ],
  "license": "ISC",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^14.0.2",
    "giget": "^2.0.0",
    "inquirer": "^8.2.6",
    "log-symbols": "^7.0.1",
    "ora": "^9.0.0",
    "update-notifier": "^7.3.1",
    "validate-npm-package-name": "^6.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/inquirer": "^9.0.9",
    "@types/node": "^22.10.5",
    "@types/update-notifier": "^6.0.8",
    "@types/validate-npm-package-name": "4.0.2",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "only-allow": "^1.2.1",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.18.2",
    "vitest": "^3.0.2"
  }
}
